# Ignore node modules
node_modules/

# Ignore environment variables
.env

# Ignore build outputs (optional but recommended)
dist/
build/

# Ignore VSCode settings (optional)
.vscode/

# Ignore Google API credentials (VERY IMPORTANT)
src/google/credentials.json
